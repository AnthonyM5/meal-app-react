# Supabase project (same project as apps/web — values match its
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Origin of the apps/web deployment that serves the mobile REST routes
# (/api/dogs, /api/meals, ...). For local dev run `pnpm --filter web dev`
# and use http://localhost:3000; on a real device use your machine's LAN IP
# (http://192.168.x.x:3000) or the deployed Vercel URL.
VITE_API_BASE_URL=http://localhost:3000
