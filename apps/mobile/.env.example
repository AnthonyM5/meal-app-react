# Supabase project (same project as apps/web — values match its
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Origin of the apps/web deployment that serves the mobile REST routes
# (/api/dogs, /api/meals, ...). For local dev run `pnpm --filter web dev`
# and use http://localhost:3000; on a real device use your machine's LAN IP
# (http://192.168.x.x:3000) or the deployed Vercel URL.
VITE_API_BASE_URL=http://localhost:3000

# Google Sign-In (native, via @capgo/capacitor-social-login).
# Create OAuth client IDs in the Google Cloud console:
#   - a "Web application" client  -> VITE_GOOGLE_WEB_CLIENT_ID (this is the
#     token audience; ALSO add it to Supabase Auth > Providers > Google
#     "Authorized Client IDs", plus your iOS/Android client IDs).
#   - an "iOS" client             -> VITE_GOOGLE_IOS_CLIENT_ID (its REVERSED
#     value goes in ios/App/App/Info.plist CFBundleURLTypes).
#   - an "Android" client (register the app's SHA-1) — no env var needed.
VITE_GOOGLE_WEB_CLIENT_ID=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
VITE_GOOGLE_IOS_CLIENT_ID=YOUR-IOS-CLIENT-ID.apps.googleusercontent.com
